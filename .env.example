# Sao chép thành .env và điền thông tin thực

# ── Jetson ─────────────────────────────────────────
SERVER_URL=http://192.168.1.x:8888
CATEGORY=san_pham
SAVE_DIR=/home/user/data/products

# Camera IP (ưu tiên dùng RTSP_URL)
RTSP_URL=rtsp://admin:password@192.168.x.x:554/Streaming/Channels/101

# Camera USB (dùng khi không có RTSP_URL)
# CAM_INDEX=0

# ── Server ─────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8888
